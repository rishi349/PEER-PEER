# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://hierarchy:hierarchy@localhost:5432/hierarchy_platform?schema=public"

# Redis (matches docker-compose.yml) — connected + health-checked in
# Phase 1, used functionally starting Phase 4 (Presence)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-in-real-deployments"
JWT_REFRESH_SECRET="change-me-refresh-secret-in-real-deployments"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
